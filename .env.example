# ============================================================
# RMHealth API — Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# NEVER use the example values in production.
# ============================================================

# --- Authentication ---
API_SECRET_TOKEN=CHANGE_ME_generate_a_random_64_char_string
JWT_SECRET_KEY=CHANGE_ME_generate_a_random_64_char_string

# --- Database (PostgreSQL) ---
DB_USER=postgres
DB_PASS=CHANGE_ME_use_a_strong_password
DB_NAME=rmhealth_medical
DB_HOST=127.0.0.1

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=https://yourdomain.com,https://dashboard.yourdomain.com

# --- Google Cloud Run (set automatically by GCP) ---
# PORT=8080

# --- Twilio SMS (for emergency notifications) ---
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# --- Hospital API (future integration) ---
# HOSPITAL_API_ENDPOINT=https://hospital-system.health/fhir/R4
