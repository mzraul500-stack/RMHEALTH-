# =============================================================================
# RMHEALTH MEDICAL SYSTEM - AZURE CONTAINER APPS ENVIRONMENT
# =============================================================================
# Variables de entorno para despliegue médico seguro
# Compliance: HIPAA + Azure Security Best Practices
# Date: April 21, 2026

# =============================================================================
# APLICACIÓN MÉDICA CORE
# =============================================================================
ENVIRONMENT=production
LOG_LEVEL=INFO
DEBUG=false

# API Configuration (Container Apps optimized)
HOST=0.0.0.0
PORT=8000
WORKERS=1
MAX_WORKERS=4

# =============================================================================
# SEGURIDAD MÉDICA (HIPAA COMPLIANCE)
# =============================================================================
# JWT Authentication (se obtiene de Key Vault)
SECRET_KEY=${SECRET_KEY}
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# Security Headers para datos médicos
SECURE_HEADERS=true
FORCE_HTTPS=true
CORS_ORIGINS=https://rmhealth.com,https://app.rmhealth.com

# =============================================================================
# BASE DE DATOS MÉDICA (PostgreSQL Azure Flexible Server)
# =============================================================================
# Database Connection (valores se obtienen de Key Vault)
POSTGRES_HOST=${POSTGRES_HOST}
POSTGRES_PORT=5432
POSTGRES_DB=${POSTGRES_DB}
POSTGRES_USER=${POSTGRES_USER}
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}

# Database Pool Configuration (optimizado para Container Apps)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# =============================================================================
# SISTEMA MÉDICO ESPECÍFICO
# =============================================================================
# Medical System Configuration
ENABLE_VITALS_MONITORING=true
ENABLE_EMERGENCY_ALERTS=true
ENABLE_HOSPITAL_INTEGRATION=true
ENABLE_FHIR_ENDPOINTS=true

# ML Models Configuration
MODELS_PATH=/app/models
CARDIAC_MODEL_PATH=/app/models/cardiac_lstm
ENABLE_ML_PREDICTIONS=true

# Emergency Response Configuration
EMERGENCY_RESPONSE_TIMEOUT=30
HOSPITAL_SEARCH_RADIUS_KM=50
MAX_HOSPITALS_PER_ALERT=5

# =============================================================================
# MONITOREO Y TELEMETRÍA (Application Insights)
# =============================================================================
# Application Insights (se obtiene de Key Vault)
APPINSIGHTS_INSTRUMENTATIONKEY=${APPINSIGHTS_INSTRUMENTATIONKEY}
APPINSIGHTS_CONNECTION_STRING=${APPINSIGHTS_CONNECTION_STRING}

# Logging Configuration
ENABLE_REQUEST_LOGGING=true
ENABLE_PERFORMANCE_MONITORING=true
ENABLE_ERROR_TRACKING=true

# =============================================================================
# AZURE INTEGRATION
# =============================================================================
# Managed Identity para acceso seguro
AZURE_CLIENT_ID=${AZURE_CLIENT_ID}
AZURE_TENANT_ID=${AZURE_TENANT_ID}

# Key Vault Configuration
KEY_VAULT_URL=${KEY_VAULT_URL}
USE_MANAGED_IDENTITY=true

# Storage Account (para archivos médicos si es necesario)
AZURE_STORAGE_ACCOUNT=${AZURE_STORAGE_ACCOUNT}
AZURE_STORAGE_CONTAINER=medical-files

# =============================================================================
# CONFIGURACIÓN DE RENDIMIENTO
# =============================================================================
# Container Apps Performance Optimization
CONTAINER_CPU_LIMIT=2.0
CONTAINER_MEMORY_LIMIT=4Gi
CONTAINER_CPU_REQUEST=0.5
CONTAINER_MEMORY_REQUEST=1Gi

# Scaling Configuration
MIN_REPLICAS=1
MAX_REPLICAS=10
SCALE_RULE_TYPE=http
SCALE_RULE_CONCURRENT_REQUESTS=100

# Cache Configuration (Redis si está disponible)
REDIS_ENABLED=false
REDIS_HOST=${REDIS_HOST}
REDIS_PORT=6380
REDIS_SSL=true

# =============================================================================
# COMPLIANCE Y AUDITORÍA
# =============================================================================
# HIPAA Compliance Settings
ENABLE_AUDIT_LOGGING=true
ENCRYPT_SENSITIVE_DATA=true
DATA_RETENTION_DAYS=2555  # 7 years HIPAA requirement

# Geographic Configuration para hospitales
DEFAULT_COUNTRY=MX
DEFAULT_TIMEZONE=America/Mexico_City
ENABLE_GEOSPATIAL_QUERIES=true

# =============================================================================
# NOTAS IMPORTANTES
# =============================================================================
# 🔐 SECRETOS: Todos los valores ${} deben configurarse en Key Vault
# 📊 MONITOREO: Application Insights configurado para telemetría médica
# 🏥 HIPAA: Configuración compliant con regulaciones médicas
# ⚡ PERFORMANCE: Optimizado para Container Apps scaling
# 🔍 DEBUGGING: Logs estructurados para troubleshooting médico