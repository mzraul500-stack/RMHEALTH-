# --- API Connection ---
EXPO_PUBLIC_API_BASE_URL=https://rmhealth-api-358326204697.us-central1.run.app/api
EXPO_PUBLIC_API_TOKEN=CHANGE_ME_use_your_API_SECRET_TOKEN_value
