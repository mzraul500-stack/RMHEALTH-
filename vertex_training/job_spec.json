{
  "displayName": "rmhealth-triage-v2",
  "jobSpec": {
    "workerPoolSpecs": [
      {
        "machineSpec": {
          "machineType": "n1-standard-4"
        },
        "replicaCount": "1",
        "pythonPackageSpec": {
          "executorImageUri": "us-docker.pkg.dev/vertex-ai/training/sklearn-cpu.1-3:latest",
          "packageUris": [
            "gs://rmhealth-training-artifacts/training_scripts/trainer-0.1.tar.gz"
          ],
          "pythonModule": "trainer.task",
          "env": [
            {
              "name": "AIP_BUCKET",
              "value": "rmhealth-training-artifacts"
            },
            {
              "name": "AIP_MODEL_DIR",
              "value": "gs://rmhealth-training-artifacts/models/"
            }
          ]
        }
      }
    ]
  }
}
