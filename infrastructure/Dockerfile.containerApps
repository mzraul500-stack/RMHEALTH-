# syntax=docker/dockerfile:1
# check=skip=critical_high_vulnerabilities,CriticalHighVulnerabilities
# =============================================================================
# RMHEALTH MEDICAL SYSTEM - AZURE CONTAINER APPS OPTIMIZED DOCKERFILE
# =============================================================================
# Production Medical API - FastAPI + ML Models + HIPAA Compliance
# Optimized for Azure Container Apps deployment
# Date: April 21, 2026

# =============================================================================
# STAGE 1: Builder - Dependencies and ML Models
# =============================================================================
FROM cgr.dev/chainguard/python:latest-dev AS builder

# Chainguard images run as non-root by default; use root only for package install.
USER root

# Container metadata for medical system
LABEL maintainer="Raul Morales - RMHealth Medical Systems"
LABEL version="2.0.0"
LABEL description="RMHealth Medical API - HIPAA Compliant Healthcare System for Azure Container Apps"
LABEL org.opencontainers.image.title="RMHealth Medical System"
LABEL org.opencontainers.image.description="Emergency response system for medical monitoring"
LABEL org.opencontainers.image.vendor="RMHealth Medical Systems"

# Environment variables optimized for Container Apps
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    POETRY_NO_INTERACTION=1 \
    POETRY_VENV_IN_PROJECT=1 \
    POETRY_CACHE_DIR=/tmp/poetry_cache

# Install system dependencies for medical/ML libraries (minimized for Container Apps)
RUN apk add --no-cache \
    build-base \
    curl \
    postgresql-dev \
    pkgconf \
    hdf5-dev \
    openblas-dev \
    gfortran \
    libjpeg-turbo-dev \
    libpng-dev \
    && rm -rf /var/cache/apk/*

# Create working directory
WORKDIR /app

# Create isolated Python environment for reliable cross-stage copy
RUN python -m venv $VIRTUAL_ENV

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --upgrade pip && \
    pip install -r requirements.txt && \
    pip install psycopg2-binary && \
    # Clean up build dependencies to reduce image size
    find /opt/venv -name "*.pyc" -delete && \
    find /opt/venv -name "__pycache__" -type d -exec rm -rf {} + || true

# =============================================================================
# STAGE 2: Production Runtime - Container Apps Optimized
# =============================================================================
FROM cgr.dev/chainguard/python:latest AS production

# Container Apps specific environment variables
ENV VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    # Container Apps specific settings
    PORT=8000 \
    HOST=0.0.0.0 \
    WORKERS=1 \
    # Medical system specific
    ENVIRONMENT=production \
    LOG_LEVEL=INFO \
    # HIPAA compliance
    SECURE_HEADERS=true \
    FORCE_HTTPS=true

# Set working directory
WORKDIR /app

# Copy Python virtual environment from builder
COPY --from=builder /opt/venv /opt/venv

# Copy application code (organized for medical system)
COPY --chown=65532:65532 api/ ./api/
COPY --chown=65532:65532 scripts/ ./scripts/

# Chainguard runtime uses non-root by default (uid 65532) - HIPAA security best practice
USER 65532

# Container Apps optimized health check (simplified for faster startup)
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health', timeout=5)" || exit 1

# CRITICAL: Container Apps requires single port exposure
EXPOSE 8000

# Reset base image entrypoint to run CMD directly
ENTRYPOINT []

# Container Apps optimized command (single worker for better resource management)
# Container Apps handles horizontal scaling, so single worker per container is optimal
CMD ["sh", "-c", "uvicorn api.app:app --host ${HOST:-0.0.0.0} --port ${PORT:-8000} --workers ${WORKERS:-1} --log-level ${LOG_LEVEL:-info}"]

# =============================================================================
# MEDICAL SYSTEM METADATA
# =============================================================================
